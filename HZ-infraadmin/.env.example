# Copy to .env.local and adjust. Restart `npm run dev` after changes.

NEXTAUTH_URL=http://localhost:3003
INFRA_ADMIN_NEXTAUTH_SECRET=use-a-long-random-string-in-prod

# Nest HZ-infrabackend (must match the process you run on PORT, usually 4001).
# Prefer 127.0.0.1 on Windows so the Next server and browser both hit the same host.
INFRA_BACKEND_URL=http://127.0.0.1:4001
NEXT_PUBLIC_INFRA_API_URL=http://127.0.0.1:4001

# On HZ-infrabackend set the SAME value as either JWT_SECRET or INFRA_JWT_SECRET (see auth.module.ts).
# The admin UI does not sign API tokens; only the Nest app does.
