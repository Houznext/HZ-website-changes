TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
JWT_SECRET=
# --- Outbound email (SMTP) ---
# Resend (recommended on Railway — Gmail SMTP often times out from cloud hosts):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxx          # Resend API key
#   SMTP_FROM=Houznext <business@houznext.com>   # must be a verified Resend domain address
# Gmail (local/dev only; use App Password, not your login password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=business@houznext.com
#   SMTP_PASS=
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=Houznext <business@houznext.com>

# Comma-separated inbox(es) for "CRM lead deleted" notifications (defaults to SMTP_FROM / business@houznext.com)
CRM_LEAD_DELETE_NOTIFY_EMAIL=

# Comma-separated inbox(es) for LiveBuild room-removed alerts (defaults to SMTP_FROM / business@houznext.com)
LIVEBUILD_ROOM_DELETE_NOTIFY_EMAIL=

# LiveBuild: projects persist across server restarts by default.
# LIVEBUILD_SEED=true — re-seed demo data only when tables are empty (optional).
# LIVEBUILD_PURGE_ON_START=true — wipe ALL LiveBuild tables on next API start (destructive; dev reset only).
# LIVEBUILD_PROJECT_DELETE_NOTIFY_EMAIL= — comma-separated inboxes for project-deleted alerts (falls back to LIVEBUILD_ROOM_DELETE_NOTIFY_EMAIL / SMTP_FROM)

# UltraMsg (https://ultramsg.com) — WhatsApp API for confirmations + lead alerts
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# Public backend URL for invoice PDF / restore links in emails (e.g. https://api.houznext.com)
PUBLIC_API_URL=

# Invoice PDF (Puppeteer). On Railway, nixpacks.toml sets Chromium + this path.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_SKIP_DOWNLOAD=true

# Digits only or with country code; default 919759750770 (+91 97597 50770)
CONTACT_LEAD_WHATSAPP_TO=919759750770

# Finance admin notifications (invoice/quotation create, update, delete + restore links)
# Defaults to address in SMTP_FROM, else business@houznext.com
FINANCE_NOTIFY_EMAIL=business@houznext.com

# Public assets / outbound copy (optional)
HOUZNEXT_LOGO_URL=
# WhatsApp portfolio attachment; leave empty to send text only
HOUZNEXT_PORTFOLIO_PDF_URL=

# Admin app URL shown when a customer hits an admin-only API
ADMIN_APP_URL=https://houznext.com

# Razorpay (optional — omit for local dev without checkout; required to create payment sessions / refunds)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Optional legacy aliases some clients use: RAZORPAY_KEY, RAZORPAY_SECRET
# RAZORPAY_WEBHOOK_SECRET=

# One-time scripts (optional)
# MIGRATE_LEGACY_ADMIN_EMAIL=
# MIGRATE_LEGACY_BRANCH_REGEX=

